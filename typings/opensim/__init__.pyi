    def attachGeometry(self, *args: Any, **kwargs: Any) -> Any:
        "Attach Geometry to this Frame and have this Frame take ownership of\n        it by adding it to this Frame's <attached_geometry> property list.\n        The Geometry is treated as being fixed to this Frame such that the\n        transform used to position the Geometry is that of this Frame."
        ...

    def clone(self, *args: Any, **kwargs: Any) -> Any: ...

