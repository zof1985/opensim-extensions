        ...

    def capacity(self, *args: Any, **kwargs: Any) -> Any:
        'Return the number of elements this array can currently hold without\nrequiring reallocation. The value returned by capacity() is always greater\nthan or equal to size(), even if the data is not owned by this array in\nwhich case we have capacity() == size() and the array is not reallocatable. *'
        ...

    def cbegin(self, *args: Any, **kwargs: Any) -> Any:
        'Return a const pointer to the first element of this array if any, otherwise\ncend(), which may be null (0) in that case but does not have to be. This method\nis from the proposed C++0x standard; there is also an overloaded begin() from\nthe original standard that returns a const pointer. *'
        ...

    def cdata(self, *args: Any, **kwargs: Any) -> Any:
        'Return a const pointer to the first element of the array, or possibly\n(but not necessarily) null (0) if the array is empty.\nNotes: \n    cdata() does not appear to be in the C++0x standard although it would seem\n    obvious in view of the cbegin() and cend() methods that had to be added.\n    The C++0x overloaded const data() method is also available. *'
        ...

    def cend(self, *args: Any, **kwargs: Any) -> Any:
        "Return a const pointer to what would be the element just after the last one\nin the array; this may be null (0) if there are no elements but doesn't have to\nbe. This method is from the proposed C++0x standard; there is also an\noverloaded end() from the original standard that returns a const pointer. *"
        ...

    def clear(self, *args: Any, **kwargs: Any) -> Any:
        "Erase all the elements currently in this array without changing the\ncapacity; equivalent to erase(begin(),end()) but a little faster. Size is\nzero after this call. T's destructor is called exactly once for each element\nin the array.\n\nTitle: Complexity:\n    O(n) if T has a destructor; constant time otherwise. *"
        ...

    def crbegin(self, *args: Any, **kwargs: Any) -> Any:
