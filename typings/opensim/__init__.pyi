class BallJoint(Joint):
    'A class implementing a Ball joint. The underlying implementation in Simbody is\nSimTK::MobilizedBody::Ball. The Ball joint implements a fixed 1-2-3 (X-Y-Z)\nbody-fixed Euler sequence, without translations, for generalized coordinate\ncalculation. Ball joint uses quaternions in calculation and are therefore\nsingularity-free (unlike GimbalJoint). Generalized speeds are equal to the\ncomputed angular velocities (:math:`\\vec{u} = \\vec{\\omega}`), not a differentiation\nof position (:math:`\\vec{u} \\neq \\dot{\\vec{q}}`).\n\nImage: ballJoint.gif\n\nAuthor: Ajay Seth'
    ...

    def assign(self, *args: Any, **kwargs: Any) -> Any: ...

    def clone(self, *args: Any, **kwargs: Any) -> Any: ...

    def getClassName(self, *args: Any, **kwargs: Any) -> Any: ...

    def getConcreteClassName(self, *args: Any, **kwargs: Any) -> Any: ...

    def getCoordinate(self, *args: Any, **kwargs: Any) -> Any:
        '*Overload 1:*\nConvenience method to get a const reference to the Coordinate associated\n       with a single-degree-of-freedom Joint. If the Joint has more than one\n       Coordinate, you must use get_coordinates() or provide the appropriate\n       argument to the getCoordinate() method defined in the derived class.\n\n|\n\n*Overload 2:*\nGet a const reference to a Coordinate associated with this Joint.\n       See also: Coord'
        ...

    @staticmethod
    def safeDownCast(obj: Any) -> BallJoint: ...

    def updCoordinate(self, *args: Any, **kwargs: Any) -> Any:
