    def getConcreteClassName(self, *args: Any, **kwargs: Any) -> Any: ...

    def getModel(self, *args: Any, **kwargs: Any) -> Any:
        'Get a const reference to the Model this component is part of.'
        ...

    def hasModel(self, *args: Any, **kwargs: Any) -> Any:
