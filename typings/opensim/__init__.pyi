    def getConcreteClassName(self, *args: Any, **kwargs: Any) -> Any: ...

    def getInputControlLabels(self, *args: Any, **kwargs: Any) -> Any: ...

    def getNumSynergies(self, *args: Any, **kwargs: Any) -> Any:
