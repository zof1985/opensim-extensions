class ComponentPath:
    'A representation of a path within a Component tree.\n\nThis class is effectively a wrapper around a normalized path string. A path\nstring is a sequence of path elements interspersed with \'/\' as a separator.\npath elements cannot contain:\n\n- back-slash (\'\\\')\n- forward-slash (\'/\')\n- asterisk (\'*\')\n- plus-sign (\'+\')\n\nAn empty path, "", is allowed. Adjacent separators in a path (e.g. "//") are\ncombined into one separator.\n\nAuthor: Carmichael Ong'
    ...

    def clear(self, *args: Any, **kwargs: Any) -> Any:
        'Clears the content of the ComponentPath'
        ...

    def empty(self, *args: Any, **kwargs: Any) -> Any:
        'Returns true if the path is empty'
        ...

    def formAbsolutePath(self, *args: Any, **kwargs: Any) -> Any:
        'Returns a path that is the result of resolving `this` from `otherPath`.\n\n- `otherPath` must be an absolute path; otherwise, an exception will be\n  thrown\n- if `this` is absolute, then this function just returns a copy of `this`\n\nExamples:\n\n    ComponentPath{"b/c"}.formAbsolutePath("/a") == "/a/b/c"\n    ComponentPath{"/b/c"}.formAbsolutePath("/a") == "/b/c"\n    ComponentPath{"b/c"}.formAbsolutePath("a")  // throws'
        ...

    def formRelativePath(self, *args: Any, **kwargs: Any) -> Any:
        'Find the relative Path between this Path and another Path (otherPath)\n(i.e. the Path to go FROM otherPath TO this Path). Both Paths must be\nabsolute.'
        ...

    def getComponentName(self, *args: Any, **kwargs: Any) -> Any:
        'Returns the name of the Component in the path (effectively, the last\nelement in the path).'
        ...

    def getInvalidChars(self, *args: Any, **kwargs: Any) -> Any:
        'Returns a string containing a sequence of all invalid characters.'
        ...

    def getNumPathLevels(self, *args: Any, **kwargs: Any) -> Any:
        'Returns the number of levels in the path (e.g. "/a/b/c" == 3).'
        ...

    def getParentPath(self, *args: Any, **kwargs: Any) -> Any:
        'Returns the sub-path that contains all subdirectory levels except for\nthe last one.'
        ...

    def getParentPathString(self, *args: Any, **kwargs: Any) -> Any:
        'Returns the parent path as a string.'
        ...

    def getSeparator(self, *args: Any, **kwargs: Any) -> Any: ...

    def getSubcomponentNameAtLevel(self, *args: Any, **kwargs: Any) -> Any:
        'Returns the name of a subdirectory in the path at the specified level\n(0-indexed).'
        ...

    def isAbsolute(self, *args: Any, **kwargs: Any) -> Any:
        "Returns true if the path is absolute (effectively, if it begins\nwith '/')."
        ...

    def isLegalPathElement(self, *args: Any, **kwargs: Any) -> Any:
        'Returns true if the argument does not contain any invalid characters.'
        ...

    def pushBack(self, *args: Any, **kwargs: Any) -> Any:
        'Push a string onto the end of the path.\n\nThrows if the argument contains invalid characters.'
        ...

    def root(self, *args: Any, **kwargs: Any) -> Any:
        'Returns the root component path (i.e. "/")'
        ...

    def separator(self, *args: Any, **kwargs: Any) -> Any:
        'Returns the separator used to delimit path elements in the path'
        ...

    def toString(self, *args: Any, **kwargs: Any) -> Any:
        'Returns a string representation of the ComponentPath\n(e.g. "/a/b/component").'
        ...

    def trimDotAndDotDotElements(self, *args: Any, **kwargs: Any) -> Any:
        'Resolves \'.\' and ".." elements in the path if possible. Leading ".."\nelements are allowed only in relative paths (throws if found at the\nstart of an absolute path). Also checks for invalid characters.\n\nEffectively, this is the same as internally `normalize`ing the path.'
        ...

