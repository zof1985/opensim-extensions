    def safeDownCast(obj: Any) -> AssemblySolver: ...

    def setAccuracy(self, *args: Any, **kwargs: Any) -> Any:
        '%Set the unitless accuracy of the assembly solution, which dictates\n       the number of significant digits the solution should be resolved to.\n       Note, setting the accuracy will invalidate the AssemblySolver and one\n       must call assemble() before being able to track().'
        ...

    def setConstraintWeight(self, *args: Any, **kwargs: Any) -> Any:
        '%Set the relative weighting for constraints. Use Infinity to identify the\n       strict enforcement of constraints, otherwise any positive weighting will\n       append the constraint errors to the assembly cost which the solver will\n       minimize.'
        ...

    def track(self, *args: Any, **kwargs: Any) -> Any:
        'Obtain a model configuration that meets the assembly conditions\n       (desired values and constraints) given a state that satisfies or\n       is close to satisfying the constraints. Note there can be no change\n       in the number of constraints or desired coordinates. Desired\n       coordinate values can and should be updated between repeated calls\n       to track a desired trajectory of coordinate values. Use assemble()\n       first to obtain the first solution and use track() to efficiently\n       find a nearby solution due to a small change in the desired value.'
        ...

